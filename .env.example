# Copia queste variabili su Vercel: Project → Settings → Environment Variables

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Indirizzo pubblico del sito, senza / finale (meglio un dominio tuo, es. https://primopasso.it)
NEXT_PUBLIC_SITE_URL=https://primopasso.vercel.app

# Una stringa lunga e casuale: protegge i job notturni
CRON_SECRET=

# Email mostrata su sito; riceve anche l'avviso quando un'azienda invia un annuncio
NEXT_PUBLIC_SUPPORT_EMAIL=

# Prezzo dell'annuncio in evidenza mostrato nella pagina aziende (es. "49 € + IVA"). Vuoto = "Su richiesta"
NEXT_PUBLIC_PRICE_FEATURED=

# Facoltative
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
RESEND_API_KEY=
EMAIL_FROM=
